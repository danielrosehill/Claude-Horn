#!/usr/bin/env bash
# Agent-side CLI. Toot the horn on the Claude-Horn server.
#   horn                          escalating toot at the default client (bugle first)
#   horn -t laptop -m "Approve?"  start on the laptop, with a message in the notification
#   horn -H air-horn --once       one air horn, no escalation
#   horn -H herman -m "Approve?"  a random Herman clip (groups: herman, bugles, chaos)
#   horn -s -m "Build failed"     also speak the message on the client (edge-tts)
#   horn -S "Custom words" -v en-US-GuyNeural   speak this text, in this voice
#   horn --ack <id> | --status | --horns
# Server URL: $CLAUDE_HORN_URL (default http://localhost:8787)
set -euo pipefail
URL="${CLAUDE_HORN_URL:-http://localhost:8787}"
HORN=""; TARGET=""; MSG=""; ESC=true; SAY=""; VOICE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--horn)   HORN="$2"; shift 2 ;;
    -t|--target) TARGET="$2"; shift 2 ;;
    -m|--message) MSG="$2"; shift 2 ;;
    -s|--say)    SAY=true; shift ;;
    -S|--say-text) SAY="$2"; shift 2 ;;
    -v|--voice)  VOICE="$2"; shift 2 ;;
    --once)      ESC=false; shift ;;
    --ack)       curl -fsS -X POST "$URL/ack" -d "{\"id\":\"$2\"}"; echo; exit ;;
    --status)    curl -fsS "$URL/status"; echo; exit ;;
    --horns)     curl -fsS "$URL/horns"; echo; exit ;;
    -h|--help)   sed -n 2,11p "$0"; exit ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
BODY=$(python3 -c '
import json, sys
h, t, m, e, s, v = sys.argv[1:]
body = {"horn": h or None, "target": t or None, "message": m or None, "escalate": e == "true",
        "say": True if s == "true" else (s or None), "voice": v or None}
print(json.dumps({k: x for k, x in body.items() if x is not None}))' "$HORN" "$TARGET" "$MSG" "$ESC" "$SAY" "$VOICE")
curl -fsS -X POST "$URL/toot" -H 'Content-Type: application/json' -d "$BODY"; echo
